//////////////////////
// OTP
//////////////////////

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
// Prisma schema placeholder
// MIGRATION: Added DELIVERY_AGENT to Role, deliveryAgentId to Order, and deliveryAgent relation.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


//////////////////////
// ENUMS
//////////////////////

enum Role {
  SUPER_ADMIN
  USER
  BUSINESS
  DELIVERY_AGENT
}

enum MembershipType {
  BASIC
  PREMIUM
  ELITE
}

enum OrderStatus {
  PENDING  //0
  PICKUP_REQUESTED //1
  REJECTED //-1
  READY_FOR_PICKUP //2
  REPAIRING //3
  DELIVERED //4
}

//////////////////////
// USER (Customer)
//////////////////////

model User {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  phone       String           @unique
  username    String?          @unique
  password    String?
  email       String?          @unique
  role        Role             @default(USER)
  membership  MembershipType?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  // GST (Optional)
  gstName         String?
  gstNumber       String?
  gstAddress      String?
  gstCertificate  String?   // uploaded file URL

  orders              Order[] @relation("OrderUser")
  deliveryAssignments Order[] @relation("OrderDeliveryAgent")
  payments    Payment[]

  // Avatar image URL with default empty string
  avatar      String   @default("")

  numericId   Int?             @unique
}

//////////////////////
// BUSINESS (Dealer)
//////////////////////

model Business {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  // Login
  email           String   @unique
  password        String

  // Dealer Info
  dealerName      String
  contactNumber   String   @unique
  referralCode    String?

  // GST (Optional)
  gstName         String?
  gstNumber       String?
  gstAddress      String?
  gstCertificate  String?   // uploaded file URL

  // Status
  approved        Boolean  @default(false)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())

  orders          Order[]
}

//////////////////////
// ORDER / SERVICE
//////////////////////

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String?       @unique

  // Relations
  userId          String
  businessId      String?
  deliveryAgentId String?

  user            User?         @relation("OrderUser", fields: [userId], references: [id])
  deliveryAgent   User?         @relation("OrderDeliveryAgent", fields: [deliveryAgentId], references: [id])
  business        Business?     @relation(fields: [businessId], references: [id])

  // Service Details
  membershipType  MembershipType
  brandName       String
  productName     String
  imeiNumber      String
  billImage       String
  utrScreenshot   String?
  invoicePdf      String?
  serviceDate     DateTime
  billingDate     DateTime?
  deliveryDate    DateTime?
  serviceCenterDate DateTime?

  customerName    String
  contactNumber   String

  // Address (BASIC only, validated in API)
  state           String?
  pincode         String?
  fullAddress     String?

  // Additional fields for order update
  preferredDate   DateTime?
  warrantyStatus  String?
  issueType       String?
  area            String?
  pickupAddress   String?
  fix             String?
  remark          String?

  receiverName    String?
  mobileNumber    String?

  amount          Float
  orderStatus     Int   @default(0)
  paymentStatus   Int   @default(0) // -1 = REJECTED, 0 = PENDING, 1 = VERIFY
  paymentId       String?

  payments        Payment[]

  // Expiry date for ELITE membership
  expireDate      DateTime?

  createdAt       DateTime      @default(now())
  deleted         Boolean       @default(false)
}

//////////////////////
// ORDER HISTORY
//////////////////////

model OrderHistory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String
  userId          String?
  actionType      String
  sourceType      String
  sourceRoute     String
  requestPayload  Json?
  appliedPayload  Json?
  beforeState     Json?
  afterState      Json?
  batchId         String?
  createdAt       DateTime @default(now())

  // ⚡ PERFORMANCE: Indexes for common queries
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
  @@index([sourceType])
  @@index([sourceRoute])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

//////////////////////
// PAYMENT
//////////////////////

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  userId      String
  orderId     String

  user        User?    @relation(fields: [userId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])

  amount      Float
  status      String   // PENDING | VERIFY | REJECTED | PAID | FAILED
  paymentStatus Int     @default(0) // -1 = REJECTED, 0 = PENDING, 1 = VERIFY
  paymentDate DateTime?  @default(now())
  razorpayId  String?

  createdAt   DateTime @default(now())
}

//////////////////////
// SUPER ADMIN
//////////////////////

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      Role     @default(SUPER_ADMIN)
  createdAt DateTime @default(now())
}

//////////////////////
// MEMBERSHIP PRICING
//////////////////////

model MembershipPricing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String   // "USER" or "BUSINESS"
  type      String   // "BASIC", "PREMIUM", "ELITE"
  price     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, type])
}

//////////////////////
// BANNERS
//////////////////////

model Banner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
