//////////////////////
// OTP
//////////////////////

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum Role {
  SUPER_ADMIN
  USER
  BUSINESS
  DELIVERY_AGENT
}

enum MembershipType {
  BASIC
  PREMIUM
  ELITE
}

enum OrderStatus {
  PENDING //0
  PICKUP_REQUESTED //1
  REJECTED //-1
  READY_FOR_PICKUP //2
  REPAIRING //3
  DELIVERED //4
}

enum DeliveryStatus {
  PENDING //0 - Initial state when order created
  REQUEST_ACCEPTED //1 - Seller accepted the request
  IN_TRANSIT //2 - Order is in transit
  OUT_FOR_DELIVERY //3 - Out for delivery
  DELIVERED //4 - Successfully delivered
  REJECTED //5 - Seller rejected the request
}

enum PhoneCondition {
  GOOD
  AVERAGE
  BAD
}

//////////////////////
// USER (Customer)
//////////////////////

model User {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  phone      String          @unique
  username   String?
  password   String?
  email      String?
  role       Role            @default(USER)
  membership MembershipType?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  // GST (Optional)
  gstName        String?
  gstNumber      String?
  gstAddress     String?
  gstCertificate String? // uploaded file URL

  orders              Order[]           @relation("OrderUser")
  deliveryAssignments Order[]           @relation("OrderDeliveryAgent")
  payments            Payment[]
  oldPhoneListings    OldPhoneListing[]
  oldPhoneOrders      OldPhoneOrder[]
  notifications       Notification[]

  // Avatar image URL with default empty string
  avatar String @default("")

  address     String?
  city        String?
  state       String?
  pincode     String?
  serviceArea String?

  aadharNumber String?
  aadharFront  String?
  aadharBack   String?
  dlNumber     String?
  dlPhoto      String?
  otherDoc     String?

  numericId Int?
}

//////////////////////
// BUSINESS (Dealer)
//////////////////////

model Business {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Login
  email    String @unique
  password String

  // Dealer Info
  dealerName    String
  contactNumber String  @unique
  referralCode  String?

  // GST (Optional)
  gstName        String?
  gstNumber      String?
  gstAddress     String?
  gstCertificate String? // uploaded file URL

  // Status
  approved Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  oldPhoneListings OldPhoneListing[]
  notifications    Notification[]
}

//////////////////////
// ORDER / SERVICE
//////////////////////

model Order {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId String?

  // Relations
  userId          String
  deliveryAgentId String?

  user          User?     @relation("OrderUser", fields: [userId], references: [id])
  deliveryAgent User?     @relation("OrderDeliveryAgent", fields: [deliveryAgentId], references: [id])
  // Flexible businessId string (allows both ObjectId and dealer name strings)
  businessId      String?

  // Service Details
  membershipType    MembershipType
  brandName         String
  productName       String
  imeiNumber        String
  billImage         String
  utrScreenshot     String?
  invoicePdf        String?
  serviceDate       DateTime
  billingDate       DateTime?
  deliveryDate      DateTime?
  serviceCenterDate DateTime?

  customerName  String
  contactNumber String

  // Address (BASIC only, validated in API)
  state       String?
  pincode     String?
  fullAddress String?

  // Additional fields for order update
  preferredDate  DateTime?
  warrantyStatus String?
  issueType      String?
  area           String?
  pickupAddress  String?
  fix            String?
  remark         String?

  receiverName String?
  mobileNumber String?

  amount        Float
  orderStatus   Int     @default(0)
  paymentStatus Int     @default(0) // -1 = REJECTED, 0 = PENDING, 1 = VERIFY
  paymentId     String?

  payments Payment[]

  // Expiry date for ELITE membership
  expireDate DateTime?

  createdAt DateTime @default(now())
  deleted   Boolean  @default(false)

  @@index([deleted])
  @@index([orderStatus])
  @@index([deliveryAgentId])
  @@index([userId])
  @@index([createdAt])
  @@index([orderStatus, deleted])
  @@index([deliveryAgentId, orderStatus])
}

//////////////////////
// OLD PHONE LISTING
//////////////////////

model OldPhoneListing {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  listingId String?

  // Relations
  userId     String
  businessId String?

  user     User?     @relation(fields: [userId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  // Phone Details
  phoneName      String
  phoneModel     String
  phoneStorage   String
  phoneRam       String?
  mobileRepaired Boolean?
  phoneColor     String
  phonePrice     Float
  imeiNumber     String?
  description    String?

  // Condition Details
  phoneOn              Boolean?
  displayWorking       Boolean?
  displayGlassDamage   Boolean?
  bodyCondition        PhoneCondition @default(GOOD)
  simSlotsWorking      Boolean?
  volumeButtonsWorking Boolean?
  fingerprintWorking   Boolean?
  cameraWorking        Boolean?
  speakerWorking       Boolean?

  // Additional Details
  financeKitAvailable Boolean?
  accessories         String[] // Box, Charger, Bill, Headphones, Cable
  warranty            Boolean?

  // Images
  images       String[] // Array of image URLs
  billImage    String? // Purchase bill image URL
  purchaseDate String?
  gift         String?
  exactPrice   Float?

  // Status
  isActive Boolean @default(true)
  isSold   Boolean @default(false)

  orders OldPhoneOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([businessId])
  @@index([isActive])
  @@index([createdAt])
}

//////////////////////
// OLD PHONE ORDER
//////////////////////

model OldPhoneOrder {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId String?

  // Relations
  listingId String
  userId    String // Customer who placed the order
  sellerId  String // Business/User who listed the phone

  listing OldPhoneListing @relation(fields: [listingId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  // Order Details
  customerName   String
  customerPhone  String
  offerPrice     Float
  exactPrice     Float?
  gift           String?
  deliveryStatus Int     @default(0) // 0=Pending, 1=Accepted, 2=In Transit, 3=Out for Delivery, 4=Delivered, 5=Rejected
  remark         String? // Remark for status update
  feedback       String? // Customer feedback after delivery
  rating         Int?    @default(0) // Rating from 1-5

  // Delivery Details
  deliveryAddress String?
  deliveryDate    DateTime?

  // Payment Details
  paymentMethod   String?
  paymentId       String?
  paymentDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([userId])
  @@index([sellerId])
  @@index([deliveryStatus])
  @@index([createdAt])
}

//////////////////////
// NOTIFICATION
//////////////////////

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relations
  userId     String?
  businessId String?

  user     User?     @relation(fields: [userId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  // Notification Details
  title   String
  message String
  type    String // order, completed, pending, success, warning, info
  isRead  Boolean @default(false)

  // Related Entity
  relatedId String? // Can be orderId, listingId, etc.

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([businessId, isRead])
}

//////////////////////
// ORDER HISTORY
//////////////////////

model OrderHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String
  userId         String?
  actionType     String
  sourceType     String
  sourceRoute    String
  requestPayload Json?
  appliedPayload Json?
  beforeState    Json?
  afterState     Json?
  batchId        String?
  paymentStatus  Int      @default(0) // -1 = REJECTED, 0 = PENDING, 1 = VERIFY
  createdAt      DateTime @default(now())

  // âš¡ PERFORMANCE: Indexes for common queries
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
  @@index([sourceType])
  @@index([sourceRoute])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

//////////////////////
// PAYMENT
//////////////////////

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId  String
  orderId String

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  amount        Float
  status        String // PENDING | VERIFY | REJECTED | PAID | FAILED
  paymentStatus Int       @default(0) // -1 = REJECTED, 0 = PENDING, 1 = VERIFY
  paymentDate   DateTime? @default(now())
  razorpayId    String?

  createdAt DateTime @default(now())
}

//////////////////////
// SUPER ADMIN
//////////////////////

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      Role     @default(SUPER_ADMIN)
  createdAt DateTime @default(now())
}

//////////////////////
// MEMBERSHIP PRICING
//////////////////////

model MembershipPricing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String // "USER" or "BUSINESS"
  type      String // "BASIC", "PREMIUM", "ELITE"
  price     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, type])
}

//////////////////////
// BANNERS
//////////////////////

model Banner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// BUYBACK SYSTEM MODELS
//////////////////////

model DeviceMaster {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  brand              String
  model              String
  name               String?  // Friendly brand + model display key, e.g. "iQOO Z7 5G", "Apple iPhone 11"
  storage            String
  launchPrice        Float
  launchDate         String?
  basePriceExcellent Float
  basePriceGood      Float
  basePriceAverage   Float
  isActive           Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([brand, model, storage])
  @@index([brand, model])
  @@index([name])
  @@index([isActive])
  @@index([isDeleted])
}

model PricingRule {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  rulesVersion       Int      @unique
  
  // Multipliers (JSON) e.g., { "flawless": 1.0, "scratched": 0.8 }
  screenFactors      Json
  bodyFactors        Json
  functionalFactors  Json
  batteryFactors     Json
  
  // Flat Deductions
  noBillDeduction    Float
  noBoxDeduction     Float
  noChargerDeduction Float
  
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  @@index([isActive])
}

model PriceRule {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  screenDamageDeduction Float    @default(0)
  batteryDeduction      Float    @default(0)
  cameraDeduction       Float    @default(0)
  fingerprintDeduction  Float    @default(0)
  faceIdDeduction       Float    @default(0)
  bodyDamageDeduction   Float    @default(0)
  speakerDeduction      Float    @default(0)
  chargingPortDeduction Float    @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive])
}

model Quote {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  quoteNumber       String   @unique
  userId            String?
  
  // Old fields for backward compat
  brand             String?
  model             String?
  storage           String?
  condition         String?
  screenCracked     Boolean  @default(false)
  batteryHealth     Int      @default(100)
  cameraIssue       Boolean  @default(false)
  fingerprintIssue  Boolean  @default(false)
  faceIdIssue       Boolean  @default(false)
  bodyDamage        Boolean  @default(false)
  speakerIssue      Boolean  @default(false)
  chargingPortIssue Boolean  @default(false)
  estimatedPrice    Float?
  
  // New Single-Source-Of-Truth Pricing fields
  deviceId          String?  @db.ObjectId // Reference to DeviceMaster
  basePriceUsed     Float?
  conditionAnswers  Json?    // Store exact answers selected
  rulesVersion      Int?
  breakdown         Json?
  finalPrice        Float?
  quoteType         String   @default("instant") // 'instant' | 'verified'
  expiresAt         DateTime?

  status            String   @default("pending") // pending, ordered, completed, rejected
  images            String[]
  
  // Booking Details
  customerName      String?
  customerAddress   String?
  customerPincode   String?
  contactNumber     String?
  imeiNumber        String?
  imei              String?
  paymentMode       String?
  description       String?
  pickupDate        DateTime?
  agentId           String?  @db.ObjectId

  paymentMethod     String?
  payoutDetails     Json?
  payoutMethod      String?
  upiId             String?
  bankAccount       String?
  bankIfsc          String?
  bankAccountHolder String?
  isDelayed         Boolean? @default(false)
  delayReason       String?
  invoicePdf        String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

// ===================================
// MOBILE PRICE INTELLIGENCE MODULE
// ===================================

model Device {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  brand        String
  model        String
  display      String?
  processor    String?
  ram          String?
  storage      String?
  battery      String?
  camera       String?
  os           String?
  images       String[]
  launchPrice  Float?
  releaseDate  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  currentPrices  CurrentPrice[]
  priceHistories PriceHistory[]

  @@index([brand, model])
}

model CurrentPrice {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId     String   @db.ObjectId
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  seller       String
  price        Float
  mrp          Float?
  availability String?
  productUrl   String?
  lastUpdated  DateTime @default(now())

  @@unique([deviceId, seller])
}

model PriceHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId     String   @db.ObjectId
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  seller       String
  price        Float
  mrp          Float?
  recordedAt   DateTime @default(now())

  @@index([deviceId])
  @@index([recordedAt])
}



